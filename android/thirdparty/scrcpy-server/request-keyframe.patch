@@ -0,0 +1,99 @@
+package com.genymobile.scrcpy.video;
+
+/** Optional source-side accounting before the UDP relay. No frame data, timer, or extra thread. */
+public final class VideoEncoderOutputDiagnostics {
+    public interface Sink { void publish(String json); }
+    private final Sink sink;
+    private final int sdk;
+    private final boolean preferCbr;
+    private final int target;
+    private long window = Long.MIN_VALUE;
+    private long previousPts = Long.MIN_VALUE;
+    private long frames, bytes, keys, intervals, intervalBytes, span, invalidPts;
+    private long maxFrame, maxDequeue, maxWrite, maxAge, negativeAge;
+    // Only with an input log: pictures and copies matched to their input, by inputs behind them.
+    private final EncoderInputLog inputs;
+    private long pictures, copies, unmatched, pictureLatency, maxPictureLatency, maxCopyLatency, maxBehind;
+    private final long[] behind = new long[4];
+
+    public VideoEncoderOutputDiagnostics(int sdk, boolean preferCbr, int target, Sink sink) {
+        this(sdk, preferCbr, target, sink, null);
+    }
+
+    public VideoEncoderOutputDiagnostics(int sdk, boolean preferCbr, int target, Sink sink, EncoderInputLog inputs) {
+        this.sdk = sdk; this.preferCbr = preferCbr; this.target = target; this.sink = sink; this.inputs = inputs;
+    }
+
+    public void record(int size, boolean key, long pts, long dequeueStarted, long dequeued, long writeStarted, long written) {
+        record(size, key, pts, dequeueStarted, dequeued, writeStarted, written, null);
+    }
+
+    /** With the input the log matched to this output, null if none. */
+    public void record(int size, boolean key, long pts, long dequeueStarted, long dequeued, long writeStarted, long written,
+            EncoderInputLog.Match input) {
+        if (size <= 0 || written < writeStarted || dequeued < dequeueStarted || writeStarted < dequeued) { return; }
+        if (window == Long.MIN_VALUE) { window = dequeueStarted; }
+        frames++; bytes += size; if (key) { keys++; }
+        maxFrame = Math.max(maxFrame, size);
+        maxDequeue = Math.max(maxDequeue, (dequeued - dequeueStarted) / 1000);
+        maxWrite = Math.max(maxWrite, (written - writeStarted) / 1000);
+        long age = dequeued / 1000 - pts;
+        if (age >= 0) { maxAge = Math.max(maxAge, age); } else { negativeAge++; }
+        if (previousPts != Long.MIN_VALUE) {
+            long delta = pts - previousPts;
+            if (delta > 0) { intervals++; intervalBytes += size; span += delta; }
+            else { invalidPts++; }
+        }
+        previousPts = pts;
+        if (inputs != null) { matchInput(input, dequeued); }
+        long elapsed = written - window;
+        if (elapsed < 2_000_000_000L) { return; }
+        StringBuilder json = new StringBuilder("{\"kind\":\"screen_encoder\",\"version\":1,\"stage\":\"output_sample\",\"sdk\":")
+                .append(sdk).append(",\"preferCbr\":").append(preferCbr).append(",\"targetBitrate\":").append(target)
+                .append(",\"elapsedMillis\":").append(elapsed / 1_000_000).append(",\"frames\":").append(frames)
+                .append(",\"encodedBytes\":").append(bytes).append(",\"keyFrames\":").append(keys)
+                .append(",\"maxFrameBytes\":").append(maxFrame).append(",\"ptsIntervals\":").append(intervals)
+                .append(",\"ptsIntervalBytes\":").append(intervalBytes).append(",\"ptsSpanMicros\":").append(span)
+                .append(",\"invalidPtsIntervals\":").append(invalidPts).append(",\"maxDequeueWaitMicros\":").append(maxDequeue)
+                .append(",\"maxLocalWriteMicros\":").append(maxWrite).append(",\"maxOutputAgeMicros\":").append(maxAge)
+                .append(",\"negativeOutputAges\":").append(negativeAge);
+        if (span > 0 && intervals > 0 && invalidPts == 0) {
+            json.append(",\"mediaBitrate\":").append((long) (intervalBytes * 8_000_000.0 / span));
+        }
+        try { sink.publish(json.append('}').toString()); } catch (RuntimeException ignored) { }
+        if (inputs != null) { publishInputs(elapsed); }
+        window = written;
+        frames = bytes = keys = intervals = intervalBytes = span = invalidPts = 0;
+        maxFrame = maxDequeue = maxWrite = maxAge = negativeAge = 0;
+    }
+
+    private void matchInput(EncoderInputLog.Match match, long dequeued) {
+        if (match == null) { unmatched++; return; }
+        long latency = Math.max(0, (dequeued - match.submittedNanos) / 1000);
+        maxBehind = Math.max(maxBehind, match.behind);
+        if (match.copy) { copies++; maxCopyLatency = Math.max(maxCopyLatency, latency); return; }
+        pictures++; pictureLatency += latency; maxPictureLatency = Math.max(maxPictureLatency, latency);
+        behind[Math.min(match.behind, behind.length - 1)]++;
+    }
+
+    /** From going into the encoder to coming out of it, for what OpenGL drew; nothing if it drew nothing. */
+    private void publishInputs(long elapsed) {
+        long[] drawn = inputs.drain();
+        if (drawn[0] + drawn[1] + pictures + copies > 0) {
+            StringBuilder json = new StringBuilder("{\"kind\":\"screen_encoder\",\"version\":1,\"stage\":\"input_sample\",\"sdk\":")
+                    .append(sdk).append(",\"preferCbr\":").append(preferCbr).append(",\"elapsedMillis\":").append(elapsed / 1_000_000)
+                    .append(",\"submittedPictures\":").append(drawn[0]).append(",\"submittedCopies\":").append(drawn[1])
+                    .append(",\"skippedInputs\":").append(drawn[2]).append(",\"overflowedInputs\":").append(drawn[3])
+                    .append(",\"outputPictures\":").append(pictures).append(",\"outputCopies\":").append(copies)
+                    .append(",\"unmatchedOutputs\":").append(unmatched)
+                    .append(",\"maxPictureLatencyMicros\":").append(maxPictureLatency)
+                    .append(",\"meanPictureLatencyMicros\":").append(pictures > 0 ? pictureLatency / pictures : 0)
+                    .append(",\"maxCopyLatencyMicros\":").append(maxCopyLatency).append(",\"maxInputsBehind\":").append(maxBehind)
+                    .append(",\"picturesNoneBehind\":").append(behind[0]).append(",\"picturesOneBehind\":").append(behind[1])
+                    .append(",\"picturesTwoBehind\":").append(behind[2]).append(",\"picturesMoreBehind\":").append(behind[3]);
+            try { sink.publish(json.append('}').toString()); } catch (RuntimeException ignored) { }
+        }
+        pictures = copies = unmatched = pictureLatency = maxPictureLatency = maxCopyLatency = maxBehind = 0;
+        java.util.Arrays.fill(behind, 0);
+    }
+}
