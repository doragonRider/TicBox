@@ -0,0 +1,29 @@
+package com.genymobile.scrcpy.video;
+
+import android.media.MediaCodec;
+import android.media.MediaCodecInfo;
+import android.media.MediaFormat;
+
+/** Optional rate control for a paced live stream, applied to the actual selected encoder. */
+public final class VideoRateControl {
+    private VideoRateControl() {
+    }
+
+    public static boolean preferConstantBitrate(MediaFormat format, MediaCodec codec, String mime, boolean enabled) {
+        // Preserve normal scrcpy sessions and any explicitly supplied codec option.
+        if (!enabled || format.containsKey(MediaFormat.KEY_BITRATE_MODE)) {
+            return false;
+        }
+        try {
+            MediaCodecInfo.EncoderCapabilities caps = codec.getCodecInfo().getCapabilitiesForType(mime).getEncoderCapabilities();
+            if (caps != null && caps.isBitrateModeSupported(MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_CBR)) {
+                format.setInteger(MediaFormat.KEY_BITRATE_MODE, MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_CBR);
+                return true;
+            }
+        } catch (IllegalArgumentException | IllegalStateException e) {
+            // Missing/broken capability reporting is not evidence that this codec accepts CBR.
+            // Keep its original mode; transport and requested bitrate never change here.
+        }
+        return false;
+    }
+}
--- a/server/src/main/java/com/genymobile/scrcpy/video/VideoEncoderDiagnostics.java
+++ b/server/src/main/java/com/genymobile/scrcpy/video/VideoEncoderDiagnostics.java
@@ -0,0 +1,205 @@
+package com.genymobile.scrcpy.video;
+
+import android.media.MediaCodec;
+import android.media.MediaCodecInfo;
+import android.media.MediaFormat;
+import com.genymobile.scrcpy.util.Ln;
+
+/** Optional, bounded format metadata. Never prints raw codec formats or frame contents. */
+public final class VideoEncoderDiagnostics {
+    private VideoEncoderDiagnostics() {
+    }
+
+    public static void emit(MediaCodec codec, MediaFormat requested, String mime, boolean preferCbr, String stage, int sdk) {
+        try {
+            Ln.writeEncoderMetadata(snapshot(codec, requested, mime, preferCbr, stage, sdk));
+        } catch (RuntimeException ignored) {
+            // Diagnostics must not end a working capture.
+        }
+    }
+
+    /** Room for names in one metadata line, which the Agent caps at 2048 bytes. */
+    static final int VENDOR_NAMES_BUDGET = 1_500;
+    private static final String[] RATE_WORDS = {"qp", "bitrate", "rc", "rate", "vbr", "cbr", "latency", "quality", "hq"};
+
+    public static void emitVendorParameters(MediaCodec codec, boolean preferCbr, int sdk) {
+        try {
+            String record = vendorParameters(codec, preferCbr, sdk);
+            if (record != null) {
+                Ln.writeEncoderMetadata(record);
+            }
+        } catch (RuntimeException ignored) {
+            // Diagnostics must not end a working capture.
+        }
+    }
+
+    /**
+     * The names and types of the encoder's vendor parameters (Android 12+), never their values, in
+     * one record: a newer record of the same kind replaces a waiting one on its way to the phone.
+     * Names lose the dotted prefix they all share, and rate control names come first, so those fit.
+     */
+    public static String vendorParameters(MediaCodec codec, boolean preferCbr, int sdk) {
+        if (sdk < 31) {
+            return null;
+        }
+        java.util.List<String> names = new java.util.ArrayList<>();
+        for (String name : codec.getSupportedVendorParameters()) {
+            if (name != null && name.length() <= 120 && name.matches("[A-Za-z0-9_.-]+")) {
+                names.add(name);
+            }
+        }
+        java.util.Collections.sort(names, (a, b) -> {
+            boolean rateA = rateControl(a), rateB = rateControl(b);
+            return rateA != rateB ? (rateA ? -1 : 1) : a.compareTo(b);
+        });
+        String prefix = names.isEmpty() ? "" : names.get(0);
+        for (String name : names) {
+            while (!name.startsWith(prefix)) {
+                int dot = prefix.lastIndexOf('.', prefix.length() - 2);
+                prefix = dot < 0 ? "" : prefix.substring(0, dot + 1);
+            }
+        }
+        if (!prefix.endsWith(".")) {
+            int dot = prefix.lastIndexOf('.');
+            prefix = dot < 0 ? "" : prefix.substring(0, dot + 1);
+        }
+        StringBuilder json = new StringBuilder("{\"kind\":\"screen_encoder\",\"version\":1,\"stage\":\"vendor_parameters\",\"sdk\":")
+                .append(sdk).append(",\"preferCbr\":").append(preferCbr);
+        try {
+            String name = codec.getName();
+            if (name.length() <= 128 && name.matches("[A-Za-z0-9_.-]+")) {
+                json.append(",\"encoder\":\"").append(name).append('"');
+            }
+        } catch (RuntimeException ignored) { }
+        json.append(",\"prefix\":\"").append(prefix).append("\",\"names\":[");
+        int used = 0, listed = 0;
+        for (String name : names) {
+            String entry = name.substring(prefix.length()) + ":" + type(codec, name);
+            if (used + entry.length() + 3 > VENDOR_NAMES_BUDGET) {
+                break;
+            }
+            json.append(listed == 0 ? "" : ",").append('"').append(entry).append('"');
+            used += entry.length() + 3;
+            listed++;
+        }
+        return json.append("],\"count\":").append(names.size()).append(",\"omitted\":").append(names.size() - listed).append('}').toString();
+    }
+
+    private static boolean rateControl(String name) {
+        String lower = name.toLowerCase(java.util.Locale.ROOT);
+        for (String word : RATE_WORDS) {
+            if (lower.contains(word)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** i, l, f, s or b as MediaFormat stores it; ? when the codec won't say. */
+    private static char type(MediaCodec codec, String name) {
+        try {
+            MediaCodec.ParameterDescriptor descriptor = codec.getParameterDescriptor(name);
+            if (descriptor == null) {
+                return '?';
+            }
+            switch (descriptor.getType()) {
+                case MediaFormat.TYPE_INTEGER: return 'i';
+                case MediaFormat.TYPE_LONG: return 'l';
+                case MediaFormat.TYPE_FLOAT: return 'f';
+                case MediaFormat.TYPE_STRING: return 's';
+                case MediaFormat.TYPE_BYTE_BUFFER: return 'b';
+                default: return '?';
+            }
+        } catch (RuntimeException e) {
+            return '?';
+        }
+    }
+
+    public static String snapshot(MediaCodec codec, MediaFormat requested, String mime, boolean preferCbr, String stage, int sdk) {
+        if (!"configured".equals(stage) && !"output_format".equals(stage)) {
+            throw new IllegalArgumentException("Invalid diagnostic stage");
+        }
+        StringBuilder json = new StringBuilder("{\"kind\":\"screen_encoder\",\"version\":1,\"stage\":\"")
+                .append(stage).append("\",\"sdk\":").append(sdk).append(",\"preferCbr\":").append(preferCbr);
+        try {
+            String name = codec.getName();
+            if (name.length() <= 128 && name.matches("[A-Za-z0-9_.-]+")) {
+                json.append(",\"encoder\":\"").append(name).append('"');
+            }
+        } catch (RuntimeException ignored) { }
+        try {
+            MediaCodecInfo info = codec.getCodecInfo();
+            if (sdk >= 29) {
+                json.append(",\"hardware\":").append(info.isHardwareAccelerated());
+            }
+            MediaCodecInfo.CodecCapabilities codecCaps = info.getCapabilitiesForType(mime);
+            MediaCodecInfo.EncoderCapabilities caps = codecCaps.getEncoderCapabilities();
+            if (caps != null) {
+                json.append(",\"cbrSupported\":").append(caps.isBitrateModeSupported(MediaCodecInfo.EncoderCapabilities.BITRATE_MODE_CBR));
+            }
+            String videoCaps = capabilities(codecCaps.getVideoCapabilities(), requested);
+            if (videoCaps != null) { json.append(",\"capabilities\":").append(videoCaps); }
+        } catch (RuntimeException ignored) { }
+        format(json, "configured", requested);
+        try { format(json, "input", codec.getInputFormat()); } catch (RuntimeException ignored) { }
+        if ("output_format".equals(stage)) {
+            try { format(json, "output", codec.getOutputFormat()); } catch (RuntimeException ignored) { }
+        }
+        return json.append('}').toString();
+    }
+
+    private static String capabilities(MediaCodecInfo.VideoCapabilities caps, MediaFormat requested) {
+        if (caps == null) { return null; }
+        StringBuilder json = new StringBuilder("{");
+        try {
+            android.util.Range<Integer> range = caps.getBitrateRange();
+            int lower = range.getLower(), upper = range.getUpper();
+            json.append("\"bitrateMin\":").append(lower).append(",\"bitrateMax\":").append(upper);
+        } catch (RuntimeException ignored) { }
+        try {
+            int width = requested.getInteger("width"), height = requested.getInteger("height");
+            double fps;
+            try { fps = requested.getInteger(MediaFormat.KEY_FRAME_RATE); }
+            catch (ClassCastException floating) { fps = requested.getFloat(MediaFormat.KEY_FRAME_RATE); }
+            if (width > 0 && height > 0 && fps > 0 && !Double.isNaN(fps) && !Double.isInfinite(fps)) {
+                boolean size = caps.isSizeSupported(width, height);
+                boolean rate = caps.areSizeAndRateSupported(width, height, fps);
+                if (json.length() > 1) { json.append(','); }
+                json.append("\"width\":").append(width).append(",\"height\":").append(height)
+                        .append(",\"sizeSupported\":").append(size)
+                        .append(",\"sizeRateSupported\":").append(rate);
+                if (size) {
+                    android.util.Range<Double> range = caps.getSupportedFrameRatesFor(width, height);
+                    if (!Double.isInfinite(range.getLower()) && !Double.isInfinite(range.getUpper())
+                            && !Double.isNaN(range.getLower()) && !Double.isNaN(range.getUpper())) {
+                        json.append(",\"fpsMin\":").append(range.getLower()).append(",\"fpsMax\":").append(range.getUpper());
+                    }
+                }
+            }
+        } catch (RuntimeException ignored) { }
+        return json.length() > 1 ? json.append('}').toString() : null;
+    }
+
+    private static void format(StringBuilder json, String prefix, MediaFormat format) {
+        number(json, prefix + "Bitrate", format, MediaFormat.KEY_BIT_RATE);
+        number(json, prefix + "BitrateMode", format, MediaFormat.KEY_BITRATE_MODE);
+        number(json, prefix + "Fps", format, MediaFormat.KEY_FRAME_RATE);
+        number(json, prefix + "Latency", format, "latency");
+        if (!"output".equals(prefix)) { number(json, prefix + "MaxBFrames", format, "max-bframes"); }
+        if ("input".equals(prefix)) { number(json, "inputOperatingRate", format, "operating-rate"); }
+        if ("output".equals(prefix)) { number(json, "outputReorderDepth", format, "output-reorder-depth"); }
+    }
+
+    private static void number(StringBuilder json, String label, MediaFormat format, String key) {
+        try {
+            if (!format.containsKey(key)) { return; }
+            double value;
+            try { value = format.getInteger(key); }
+            catch (ClassCastException wrongType) { value = format.getFloat(key); }
+            if (!Double.isNaN(value) && !Double.isInfinite(value) && value >= 0 && value <= 1_000_000_000L) {
+                json.append(",\"").append(label).append("\":");
+                if (value == (long) value) { json.append((long) value); } else { json.append(value); }
+            }
+        } catch (RuntimeException ignored) { }
+    }
+}
