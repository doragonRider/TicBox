+package com.genymobile.scrcpy.opengl;
+
+/**
+ * When the next picture may go into the encoder. It stands in for the framework's frame rate
+ * limit, which drops a picture that comes too soon after the last input: one that came just after a
+ * copy of the last picture was lost that way. Here a picture early for the rate waits for its turn
+ * instead. Copies count against the rate too, so that the encoder, and the display at the other end,
+ * never get two inputs within one frame interval. While the encoder is backed up the waiting
+ * picture is held, so that newer pictures replace it rather than queue behind the old ones; it goes
+ * in once the encoder has worked through its backlog, or after {@link #MAX_HOLD_NANOS} at most.
+ */
+public final class PresentationGate {
+
+    /** The framework's limit lets pictures in this early too, so a steady display isn't held. */
+    public static final long JITTER_NANOS = 2_000_000L;
+    /** Even an encoder that never drains gets a new picture this often. */
+    public static final long MAX_HOLD_NANOS = 200_000_000L;
+
+    private final long intervalNanos;
+    private boolean started;
+    private long dueNanos;
+    private boolean holding;
+    private long heldSince;
+
+    /** At most maxFps pictures a second; 0 or less for no limit. */
+    public PresentationGate(float maxFps) {
+        this.intervalNanos = maxFps > 0 ? (long) (1_000_000_000.0 / maxFps) : 0;
+    }
+
+    /** How long the waiting picture must still wait, 0 if it may go in now. */
+    public long delay(long now, boolean backedUp) {
+        if (intervalNanos > 0 && started && now < dueNanos - JITTER_NANOS) {
+            return dueNanos - JITTER_NANOS - now;
+        }
+        if (!backedUp) {
+            return 0;
+        }
+        if (!holding) {
+            holding = true;
+            heldSince = now;
+        }
+        return Math.max(0, heldSince + MAX_HOLD_NANOS - now);
+    }
+
+    /** A picture or a copy went in. Like the framework's limit, a late one doesn't earn a burst. */
+    public void presented(long now) {
+        holding = false;
+        if (intervalNanos <= 0) {
+            return;
+        }
+        dueNanos = !started || now >= dueNanos + intervalNanos ? now + intervalNanos : dueNanos + intervalNanos;
+        started = true;
+    }
+}
