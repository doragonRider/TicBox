@@ -0,0 +1,139 @@
+package com.genymobile.scrcpy.video;
+
+/**
+ * When each picture drawn through OpenGL went into the encoder. OpenGL holds new pictures back
+ * while the encoder is backed up, and diagnostics tell from it how long the encoder kept each one
+ * and how many later inputs it took in first. The drawing thread adds entries in timestamp order and
+ * the encoder thread takes them in the same order; an output whose timestamp was never drawn here
+ * (a framework repeat) matches nothing.
+ */
+public final class EncoderInputLog {
+
+    public static final int CAPACITY = 256;
+    /**
+     * Backed up: at least this many inputs in the encoder, the oldest there for {@link #BACKLOG_NANOS},
+     * and outputs still coming. MediaTek's encoders keep their last four inputs until more arrive,
+     * and in the normal flow a picture comes out within about 80 ms.
+     */
+    public static final int BACKLOG_INPUTS = 6;
+    public static final long BACKLOG_NANOS = 100_000_000L;
+    /**
+     * An encoder that gave nothing back for this long is waiting for input, not backed up. One that
+     * keeps its newest inputs looks backed up for this long after the screen stops changing.
+     */
+    public static final long OUTPUT_IDLE_NANOS = 100_000_000L;
+
+    /** One output's input; [behind] is how many later inputs were already in the encoder. */
+    public static final class Match {
+        public final long submittedNanos;
+        public final boolean copy;
+        public final int behind;
+
+        Match(long submittedNanos, boolean copy, int behind) {
+            this.submittedNanos = submittedNanos;
+            this.copy = copy;
+            this.behind = behind;
+        }
+    }
+
+    private final long[] ptsUs = new long[CAPACITY];
+    private final long[] submitted = new long[CAPACITY];
+    private final boolean[] copies = new boolean[CAPACITY];
+    private final boolean[] awaited = new boolean[CAPACITY];
+    private int awaitedHeld;
+    private int head;
+    private int size;
+    private boolean outputSeen;
+    private long lastOutput;
+    private Runnable drained;
+    private long submittedPictures;
+    private long submittedCopies;
+    private long skipped;
+    private long overflowed;
