+package com.genymobile.scrcpy.opengl;
+
+/**
+ * Copies of the last picture once the screen stops changing, for encoders that hold their newest
+ * inputs until more arrive (MediaTek's keep about four): without them the final picture of an
+ * animation waits for the next change on screen. The first copy comes a frame and a half after the
+ * picture, so that one only a little late isn't preceded by a copy, and the copies stop once the
+ * encoder holds nothing the stream waits for. An encoder that gives every picture back at once
+ * gets none.
+ */
+public final class TailRepeat {
+
+    /** At most this many copies after one picture, even if the encoder never gives it back. */
+    public static final int COUNT = 12;
+
+    private final long intervalNanos;
+    private int remaining;
+
+    public TailRepeat(long intervalUs) {
+        this.intervalNanos = intervalUs * 1000;
+    }
+
+    /** A new picture restarts the copies. Returns the delay before the first, or -1 for none. */
+    public long start() {
+        remaining = intervalNanos > 0 ? COUNT : 0;
+        return remaining > 0 ? intervalNanos * 3 / 2 : -1;
+    }
+
+    /**
+     * Whether a copy should be drawn now: only while the encoder still holds something the stream
+     * waits for, and copies are left. The delay before the next comes from next().
+     */
+    public boolean due(boolean encoderHolds) {
+        if (!encoderHolds) {
+            remaining = 0;
+        }
+        if (remaining <= 0) {
+            return false;
+        }
+        remaining--;
+        return true;
+    }
+
+    /** The delay before the next copy, or -1 for none. */
+    public long next() {
+        return remaining > 0 ? intervalNanos : -1;
+    }
+
+    /** The delay before trying again when a copy was put off. */
+    public long interval() {
+        return intervalNanos;
+    }
+}
